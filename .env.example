# Supabase Connection (Service Role required to drain queue)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Worker Settings
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10

# N8N Integration (Optional - events forwarded to n8n webhook before marked done)
N8N_WEBHOOK_URL=
